# Copy to .env.local and fill in. Variables prefixed NEXT_PUBLIC_ are exposed to the browser.

# Canonical site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.shtruckbodies.com

# Dealer-locator map tiles. Defaults to OpenStreetMap raster tiles darkened with CSS
# (fine for review / low traffic). For production use a keyed provider, e.g.
#   Stadia:   https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png?api_key=YOUR_KEY
#   MapTiler: https://api.maptiler.com/maps/dataviz-dark/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

